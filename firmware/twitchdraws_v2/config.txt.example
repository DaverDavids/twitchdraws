# WiFi
ssid=YourWiFiSSID
password=YourWiFiPassword

# mDNS hostname (advertised as <hostname>.local; also used as OTA hostname)
hostname=twitchdraws

# OTA
# ota_enabled=false   # uncomment to disable updates
# ota_password=       # leave empty for ArduinoOTA default (Arduino IDE dialog)

# Twitch
channel=your_channel_name
twitch_mode=anonymous
nick=justinfan12345
# oauth=oauth:your_token
# oauth_nick=your_bot_nick

# Display
scroll_speed=6
led_brightness=128